#[cfg(test)]
mod tests {
    use super::*;
    use tpt_proc_core::{Composition, FlowRate};

    fn inlet() -> MaterialStream {
        MaterialStream::new(1, "inlet")
            .with_state(300.0, 101_325.0)
            .unwrap()
            .with_flow(FlowRate::Molar(100.0))
            .unwrap()
            .with_composition(Composition::from_mole_fractions(&[1.0]).unwrap())
    }

    #[test]
    fn ports_match_trait_contract() {
        let unit = {{ project-name | pascal_case }};
        assert_eq!(unit.kind(), "{{ unit_kind }}");
        assert_eq!(unit.num_inlets(), {{ inlets }});
        assert_eq!(unit.num_outlets(), {{ outlets }});
    }

    #[test]
    fn solve_returns_the_right_outlet_count() {
        let unit = {{ project-name | pascal_case }};
        let inlets = vec![inlet(); unit.num_inlets()];
        let outlets = unit.solve(&inlets).unwrap();
        assert_eq!(outlets.len(), unit.num_outlets());
    }

    #[test]
    fn wrong_inlet_count_is_an_error_not_a_panic() {
        let unit = {{ project-name | pascal_case }};
        let outlets = unit.solve(&[]);
        assert!(matches!(
            outlets,
            Err(UnitError::WrongInletCount { .. })
        ));
    }
}
